# Copy this file to .env on the server and replace every example value.
PUBLIC_HOSTNAME=remotehub.example.com
ACME_EMAIL=admin@example.com
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=remotehub
JWT_AUDIENCE=remote-support
JWT_TTL=1h
ALLOWED_ORIGIN=
# Optional: compact Firebase Admin service-account JSON. Keep this file private.
FIREBASE_SERVICE_ACCOUNT_JSON={}
# Comma-separated Google OAuth client IDs (web and any native/desktop client IDs).
GOOGLE_CLIENT_IDS=
