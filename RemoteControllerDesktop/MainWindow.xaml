<Window x:Class="RemoteControllerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteControllerDesktop" Height="650" Width="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="RemoteController" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox x:Name="EmailBox" Width="190" Margin="24,0,8,0" VerticalContentAlignment="Center"
                     ToolTip="Account email"/>
            <PasswordBox x:Name="PasswordBox" Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            <Button Content="Sign in" Padding="14,7" Click="SignIn_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Actions send requests only. The device owner must approve each session."
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel x:Name="DevicePanel"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
